# ────── 数据库（生产用 PostgreSQL，开发默认 SQLite） ──────
# PostgreSQL: postgresql://用户名:密码@localhost:5432/fitfoodpk
# SQLite（开发）: 留空即可，自动使用本地 foodsticker.db
DATABASE_URL=

# 只读副本（读写分离，可选）
# DB_READ_URL=postgresql://fitfoodpk:密码@localhost:5433/fitfoodpk

# PostgreSQL 连接池调优（仅 PostgreSQL 时生效，可按需调整）
# DB_POOL_SIZE=20          # 常驻连接数（默认 20）
# DB_MAX_OVERFLOW=10       # 峰值溢出连接数（总最大 30）
# DB_POOL_RECYCLE=3600     # 连接回收时间（秒）
# DB_POOL_TIMEOUT=30       # 等待连接超时（秒）

# ────── Redis 缓存（可选，无 Redis 时自动降级） ──────
# REDIS_URL=redis://localhost:6379/0

# ────── 贴纸 CDN（可选，配置后贴纸返回 cdn_url 字段） ──────
# CDN_BASE_URL=https://cdn.rubyace.love

# ────── 数据库备份（OSS 远程存储，可选） ──────
# BACKUP_DIR=/opt/fitfoodpk/backups
# RETENTION_DAYS=30
# OSS_BUCKET=oss://your-bucket-name
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_ACCESS_KEY=your-oss-access-key
# OSS_SECRET_KEY=your-oss-secret-key

# ────── 火山方舟视觉大模型（食品识别/营养查询） ──────
VLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VLM_API_KEY=sk-your-volcano-key-here
VLM_MODEL=doubao-seed-1-6-251015

# ────── 火山方舟图生图（seedream，卡通贴纸生成） ──────
# seedream 若使用与 VLM 不同的 key，请单独填写；留空则复用 VLM_API_KEY
ARK_API_KEY=
ARK_SD_MODEL=doubao-seedream-5-0-260128

# ────── JWT 签名密钥（生产环境务必修改） ──────
JWT_SECRET=change-me-to-a-random-string

# ────── 管理后台（单管理员体系） ──────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=FitFood@2026

# ────── 本地 Stable Diffusion（高清贴纸，可选） ──────
# SD_BASE_URL=http://127.0.0.1:7860

# ────── 日志 ──────
# LOG_LEVEL=INFO            # TRACE/DEBUG/INFO/WARNING/ERROR
# LOG_JSON=true             # 生产环境 JSON 格式（便于接入 ELK/SLS）

# ────── 灰度发布 / 功能开关 ──────
# FF_NEW_UI=30              # 30% 用户看到新版 UI
# FF_NEW_UI_WHITELIST=user-1,user-5  # 白名单用户强制开启

# ────── 监控（Grafana） ──────
# GRAFANA_PASSWORD=admin123
