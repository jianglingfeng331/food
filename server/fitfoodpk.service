[Unit]
Description=FitFood PK Backend
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/fitfoodpk/server
EnvironmentFile=/opt/fitfoodpk/server/.env
Environment=STICKER_DIR=/opt/fitfoodpk/server/stickers
Environment=BACKUP_DIR=/opt/fitfoodpk/backups
ExecStart=/opt/fitfoodpk/server/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

# 安全加固
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
